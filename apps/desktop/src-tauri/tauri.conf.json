{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luma",
  "version": "0.1.0",
  "identifier": "com.ferndot.luma",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Luma",
        "width": 1120,
        "height": 720,
        "minWidth": 520,
        "minHeight": 440,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
